{
  "name": "local-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "node --enable-source-maps dist/server/index.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:verification": "node --test .claude/skills/verify-openminutes/scripts/*.test.mjs",
    "test:ci": "node scripts/check-test-dependencies.mjs && pnpm test && pnpm test:verification"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "lucide-react": "0.562.0",
    "node-ical": "^0.27.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.20.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "tsx": "^4.23.15"
  }
}
